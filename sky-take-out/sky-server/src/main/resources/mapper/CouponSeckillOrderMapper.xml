<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sky.mapper.CouponSeckillOrderMapper">

    <insert id="insert" parameterType="com.sky.entity.CouponSeckillOrder" useGeneratedKeys="true" keyProperty="id">
        insert into coupon_seckill_order(coupon_id, user_id, status, create_time)
        values (#{couponId}, #{userId}, #{status}, #{createTime})
    </insert>

</mapper>
